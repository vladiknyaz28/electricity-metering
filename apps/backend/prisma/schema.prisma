generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  fullName     String
  email        String  @unique
  passwordHash String
  role         String // 'admin' | 'object_manager' | 'consumer' | 'auditor'
  status       String  @default("active")
  /** Единственный, кто может менять Meter.tariffId (не через API/UI — только скрипт). */
  isSuperAdmin Boolean @default(false)

  consumerId String?
  consumer   Consumer? @relation(fields: [consumerId], references: [id], onDelete: SetNull)

  managedObjects    Object[]       @relation("ObjectManager")
  submittedReadings MeterReading[] @relation("SubmittedBy")
  verifiedReadings  MeterReading[] @relation("VerifiedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Object {
  id String @id @default(cuid())

  name         String
  address      String
  typeCode     String
  categoryCode String
  status       String

  managerId String?
  manager   User?   @relation("ObjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  meters    Meter[]
  consumers Consumer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Consumer {
  id String @id @default(cuid())

  objectId String
  object   Object @relation(fields: [objectId], references: [id], onDelete: Cascade)

  name          String
  type          String
  taxId         String?
  contactPerson String?
  phone         String?
  email         String?
  area          Float?
  sharePercent  Float?
  status        String

  tariffId String? // familyId серии тарифов (не id конкретной версии)
  // Связь не через Prisma FK: резолв версии по дате — TariffsService.resolveActiveTariffVersion

  meters  Meter[]
  users   User[]
  charges Charge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meter {
  id String @id @default(cuid())

  objectId String
  object   Object @relation(fields: [objectId], references: [id], onDelete: Cascade)

  consumerId String?
  consumer   Consumer? @relation(fields: [consumerId], references: [id], onDelete: SetNull)

  ownerType             String
  name                  String
  serialNumber          String    @unique
  resourceTypeCode      String
  resourceTypeId        String?
  resourceType          ResourceType? @relation(fields: [resourceTypeId], references: [id], onDelete: SetNull)
  meterCategoryCode     String
  tariffType            String
  unit                  String
  accuracyClass         String
  status                String
  verificationDueDate   DateTime?
  isMain                Boolean  @default(false)
  installationLocation  String
  hasCurrentTransformer Boolean

  primaryCurrent   Int?
  secondaryCurrent Int?
  transformerRatio Decimal? @db.Decimal(10, 4)

  parentMeterId String?
  parentMeter   Meter?  @relation("MeterHierarchy", fields: [parentMeterId], references: [id], onDelete: SetNull)
  children      Meter[] @relation("MeterHierarchy")

  /// familyId серии тарифов (как Consumer.tariffId). Используется, если у счётчика нет потребителя.
  tariffId String?
  // Связь не через Prisma FK: резолв версии по дате — TariffsService.resolveActiveTariffVersion

  readings MeterReading[]
  charges  Charge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResourceType {
  id       String  @id @default(cuid())
  name     String
  unit     String
  isSystem Boolean @default(false)
  status   String  @default("active")
  meters   Meter[]
  tariffs  Tariff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeterReading {
  id String @id @default(cuid())

  meterId String
  meter   Meter  @relation(fields: [meterId], references: [id], onDelete: Cascade)

  periodCode      String
  periodStartDate DateTime
  periodEndDate   DateTime

  previousValue Float?
  currentValue  Float?

  valueT1 Float
  valueT2 Float?
  valueT3 Float?

  /** Ручное переопределение ставки на конкретном показании (superAdmin). */
  rateT1Override Decimal? @db.Decimal(10, 3)
  rateT2Override Decimal? @db.Decimal(10, 3)
  rateT3Override Decimal? @db.Decimal(10, 3)

  readingDate DateTime
  comment     String?

  rawDelta                  Float?
  transformedDelta          Float?
  transformationCoefficient Int

  source String @default("manual")
  status String

  submittedById String?
  submittedBy   User?   @relation("SubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  verifiedById  String?
  verifiedBy    User?     @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt    DateTime?
  disputeReason String?

  isClosedPeriod Boolean @default(true)

  anomalyType String
  anomalyNote String?

  chargeStarts Charge[] @relation("ChargeStartReading")
  chargeEnds   Charge[] @relation("ChargeEndReading")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meterId, periodCode])
}

model Tariff {
  id String @id @default(cuid())

  name             String
  resourceTypeCode String
  resourceTypeId   String
  resourceType     ResourceType @relation(fields: [resourceTypeId], references: [id])

  /// Группирует версии одного логического тарифа. У первой версии familyId = id.
  familyId  String?
  status    String    @default("active")
  validFrom DateTime
  validTo   DateTime?

  zones   TariffZone[]
  charges Charge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
}

model TariffZone {
  id String @id @default(cuid())

  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  zoneCode String // 'T1' | 'T2' | 'T3'
  rate     Decimal @db.Decimal(10, 3)

  createdAt DateTime @default(now())

  @@unique([tariffId, zoneCode])
}

model Charge {
  id String @id @default(cuid())

  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id], onDelete: Cascade)

  meterId String
  meter   Meter  @relation(fields: [meterId], references: [id], onDelete: Cascade)

  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  startReadingId String
  startReading   MeterReading @relation("ChargeStartReading", fields: [startReadingId], references: [id])

  endReadingId String
  endReading   MeterReading @relation("ChargeEndReading", fields: [endReadingId], references: [id])

  consumptionT1 Float
  consumptionT2 Float?
  consumptionT3 Float?

  amountT1 Float
  amountT2 Float?
  amountT3 Float?

  totalAmount Float
  status      String @default("draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
